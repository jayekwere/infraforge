{
  "terraform": {
    "required_version": ">= 1.15.8, < 1.16",
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "7.10.0"
      }
    }
  },
  "variable": {
    "project": {
      "type": "string",
      "description": "Explicit sandbox project required; no default"
    }
  },
  "provider": {
    "google": {
      "project": "${var.project}",
      "region": "us-west1"
    }
  },
  "resource": {
    "google_compute_network": {
      "network": {
        "name": "private-service",
        "auto_create_subnetworks": false,
        "delete_default_routes_on_create": true
      }
    },
    "google_compute_subnetwork": {
      "private_0": {
        "name": "private-service-0",
        "ip_cidr_range": "10.42.1.0/24",
        "region": "us-west1",
        "network": "${google_compute_network.network.id}",
        "private_ip_google_access": true
      },
      "private_1": {
        "name": "private-service-1",
        "ip_cidr_range": "10.42.2.0/24",
        "region": "us-west1",
        "network": "${google_compute_network.network.id}",
        "private_ip_google_access": true
      }
    },
    "google_compute_firewall": {
      "private_0": {
        "name": "private-service-0",
        "network": "${google_compute_network.network.name}",
        "direction": "INGRESS",
        "priority": 1000,
        "source_ranges": [
          "10.42.0.0/16"
        ],
        "target_tags": [
          "private-service"
        ],
        "allow": [
          {
            "protocol": "tcp",
            "ports": [
              "443"
            ]
          }
        ]
      },
      "deny-egress": {
        "name": "private-service-deny-egress",
        "network": "${google_compute_network.network.name}",
        "direction": "EGRESS",
        "priority": 65534,
        "destination_ranges": [
          "0.0.0.0/0"
        ],
        "deny": [
          {
            "protocol": "all"
          }
        ]
      }
    }
  }
}
