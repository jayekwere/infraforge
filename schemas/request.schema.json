{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "module": {
      "type": "string",
      "enum": [
        "local-network-v1",
        "aws-network-v1",
        "azure-network-v1",
        "gcp-network-v1"
      ]
    },
    "cidr": {
      "type": "string"
    },
    "subnets": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingress": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cidr": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "cidr",
          "port"
        ],
        "additionalProperties": false
      }
    },
    "iam": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+:[A-Za-z]+$"
      }
    },
    "encrypted": {
      "type": "boolean"
    },
    "compute": {
      "type": "object",
      "properties": {
        "ami": {
          "type": "string",
          "pattern": "^ami-[a-f0-9]{8,17}$"
        },
        "instanceType": {
          "type": "string",
          "enum": [
            "t3.micro",
            "t3.small"
          ]
        }
      },
      "required": [
        "ami",
        "instanceType"
      ],
      "additionalProperties": false
    },
    "dns": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "address": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "zone",
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "loadBalancer": {
      "type": "object",
      "properties": {
        "certificateArn": {
          "type": "string",
          "pattern": "^arn:aws:acm:us-west-2:\\d{12}:certificate\\/[a-f0-9-]{36}$"
        },
        "port": {
          "type": "number",
          "const": 443
        },
        "healthPath": {
          "type": "string",
          "pattern": "^\\/[a-zA-Z0-9/_-]{0,80}$"
        }
      },
      "required": [
        "certificateArn",
        "port",
        "healthPath"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.@ -]{1,80}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging"
          ]
        }
      },
      "required": [
        "owner",
        "environment"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "module",
    "cidr",
    "subnets",
    "ingress",
    "iam",
    "encrypted",
    "tags"
  ],
  "additionalProperties": false
}
