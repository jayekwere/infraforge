{
	"name": "infraforge",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.13 <27"
	},
	"scripts": {
		"build": "tsc && esbuild web/app.tsx --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=web/app.js",
		"test": "node --import tsx --test test/*.test.ts",
		"start": "node dist/src/server.js",
		"demo": "node --import tsx src/demo.ts",
		"verify": "npm run build && npm test && npm run demo",
		"test:browser": "playwright test",
		"dev": "node scripts/local-server.mjs",
		"test:container": "node scripts/container-smoke.mjs",
		"test:adapters": "node scripts/adapter-fixtures.mjs && node scripts/validate-adapters.mjs",
		"test:compose": "node scripts/container-smoke.mjs infraforge:verify --compose",
		"prepare:aws": "node scripts/prepare-aws.mjs",
		"test:aws-plan": "node scripts/aws-offline-plan.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-sts": "3.1161.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"esbuild": "0.28.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	}
}
